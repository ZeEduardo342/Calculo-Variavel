rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lançamentos são imutáveis: só criar, ler e apagar (desfazer). Sem update.
    match /lancamentos/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['data','nivel','quantidade','valor_unitario','valor_total'])
                    && request.resource.data.data is string
                    && request.resource.data.nivel in [1, 2, 3, 4]
                    && request.resource.data.quantidade is int
                    && request.resource.data.quantidade > 0
                    && request.resource.data.valor_unitario is number
                    && request.resource.data.valor_unitario > 0
                    && math.abs(request.resource.data.valor_total
                         - request.resource.data.quantidade * request.resource.data.valor_unitario) < 0.005;
      allow update: if false;
      allow delete: if true;
    }

    match /valores_niveis/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nivel','valor','inicio'])
                    && request.resource.data.nivel in [1, 2, 3, 4]
                    && request.resource.data.valor is number && request.resource.data.valor > 0
                    && request.resource.data.inicio is string;
      allow update: if false;
      allow delete: if true;
    }

    match /configuracoes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['tipo','valor','inicio'])
                    && request.resource.data.tipo == 'teto_mensal'
                    && request.resource.data.valor is number && request.resource.data.valor > 0
                    && request.resource.data.inicio is string;
      allow update: if false;
      allow delete: if true;
    }
  }
}
